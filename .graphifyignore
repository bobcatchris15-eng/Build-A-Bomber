# graphify exclusion patterns (gitignore-style, last-match-wins).
# This is the corpus the user actually cares about: the Godot project
# under prototype/, the design docs under docs/, the implementation notes
# under prototype/docs/, and the Python tooling under prototype/tools/.
# Everything else — Godot import cache, bundled Blender, compiled Python,
# binary assets, generated build artifacts — is noise.

# Godot import / cache / metadata (regenerated by the editor on import)
prototype/.godot/
*.import
*.uid
*.gdignore

# Bundled 3rd-party toolchains shipped with the repo
prototype/UPBGE-*/

# Bundled Python toolchain (interpreter + site-packages, never source)
prototype/.python_venv/
prototype/Python311/
prototype/python-3.13*/
prototype/python*/

# Binary asset formats — no structural meaning, will be filtered anyway
# by detect() but pre-empting them keeps the walk cheap.
*.png
*.jpg
*.jpeg
*.webp
*.exr
*.hdr
*.bmp
*.tga
*.gif
*.glb
*.gltf
