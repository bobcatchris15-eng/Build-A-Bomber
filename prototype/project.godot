; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Kitbash Command Prototype"
config/version="1.6.4"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WindowFit="*res://scripts/window_fit.gd"
SceneRouter="*res://scripts/scene_router.gd"
TutorialManager="*res://scripts/tutorial/tutorial_manager.gd"
TwoPhaseTutorialManager="*res://scripts/tutorial_two_phase/two_phase_tutorial_manager.gd"
MatchConfig="*res://scripts/match_config.gd"
OperationsManager="*res://scripts/operations_manager.gd"
DebugSettings="*res://scripts/debug_settings.gd"
CursorManager="*res://scripts/cursor_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
SettingsService="*res://scripts/core/settings_service.gd"
InputService="*res://scripts/core/input_service.gd"
SystemLayer="*res://scripts/ui/system_layer.gd"
DesignRecord="*res://scripts/design_record.gd"
CommandRegistry="*res://scripts/battle/orders/command_registry.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://godot_master.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; SKIRMISH_PERF_TROUBLESHOOTING.md §5 Track E #2. Enum 0=disabled,
; 1=screen-tearing-prevention (engine-decides), 2=adaptive. Was
; DisplayServer.VSYNC_ENABLED; off lets the 30 Hz physics tick be
; the actual rate cap rather than the 60 Hz monitor cap. With
; vsync on, the perf_hud's FPS readout was being pinned to 60 even
; on a 3.75-fps scene (see §10.1) - turning it off lets the
; readout report the real cost. Re-enable (set to 1 or 2) if the
; visible tearing on 60 Hz monitors is unacceptable.
window/vsync/vsync_mode=0

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://resources/bomber_theme.tres"

[rendering]

textures/vram_compression/import_etc2_astc=true
; SKIRMISH_PERF_TROUBLESHOOTING.md §5 Track E #1. Enum 0=off, 1=2x, 2=4x, 3=8x.
; Was 2 (4x); 4x MSAA at 1920x1080 measured ~31% of frame time on
; an empty map. Then 1 (2x). Now 0 (off) - the §13.1 capture at 2x
; was hitting 110 ms/frame in the renderer with 17+ units; the
; next step on the Track E sweep is to drop MSAA entirely. Combined
; with vsync off (above), the perf_hud will read the true frame
; rate. Re-enable (set to 1 or 2) if aliasing on a 30 fps display
; is unacceptable.
anti_aliasing/quality/msaa_3d=0
